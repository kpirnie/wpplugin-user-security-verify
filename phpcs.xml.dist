<?xml version="1.0"?>
<ruleset name="ModeEffect User Security Validation">
	<description>WordPress Coding Standards for ModeEffect User Security Validation.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.7"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mode-user-security-validation"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Mode\UserSecurityValidation"/>
				<element value="MODE_USER_SECURITY_VALIDATION"/>
				<element value="mode_usv"/>
			</property>
		</properties>
	</rule>
</ruleset>
